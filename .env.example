# Botwx connector settings. Copy to ~/.botwx/.env or ./.env.

# Agent execution backend.
BOTWX_CLI=codex-app
BOTWX_WORKING_DIR=/absolute/path/to/your/workspace

# tmux is the durable default. Use PTY only on hosts where tmux cannot be
# installed; live sessions then cannot survive a Botwx process restart.
# BACKEND_TYPE=pty

# Optional model controls (supported by Codex-family adapters).
# BOTWX_MODEL=gpt-5.4
# BOTWX_REASONING_EFFORT=high

# Core-only synchronous turn wait, in milliseconds (1 second to 5 minutes).
BOTWX_TURN_TIMEOUT_MS=300000

# Isolated Botwx state. Defaults shown here are resolved automatically.
# BOTWX_STATE_DIR=/absolute/path/to/.botwx
# BOTWX_ENGINE_STATE_DIR=/absolute/path/to/.botwx/engine
# BOTWX_WEIXIN_STATE_DIR=/absolute/path/to/.botwx

# Local-only execution-core API.
BOTWX_API_PORT=7960
BOTWX_BOT_ID=local_botwx

# Optional when the SDK state contains more than one WeChat account.
# BOTWX_ACCOUNT_ID=your-normalized-account-id
